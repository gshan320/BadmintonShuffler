<?xml version="1.0" encoding="utf-8"?>
<!--
  A badminton court seen from above, with the shuttle sitting on the net.

  Everything stays inside the 66dp adaptive-icon safe zone (x and y from 21 to 87), so no launcher
  mask can clip the court lines. Chalk white on court teal, with the shuttle's cork as the one
  warm accent — the same three colours the app itself uses.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Doubles boundary -->
    <path
        android:fillColor="#00000000"
        android:pathData="M34,25h40v58h-40z"
        android:strokeColor="#F3F6F1"
        android:strokeWidth="3"
        android:strokeLineJoin="round" />

    <!-- Singles side lines -->
    <path
        android:fillColor="#00000000"
        android:pathData="M40,25L40,83"
        android:strokeColor="#66F3F6F1"
        android:strokeWidth="1.5" />
    <path
        android:fillColor="#00000000"
        android:pathData="M68,25L68,83"
        android:strokeColor="#66F3F6F1"
        android:strokeWidth="1.5" />

    <!-- Service lines, one each side of the net -->
    <path
        android:fillColor="#00000000"
        android:pathData="M34,44h40"
        android:strokeColor="#66F3F6F1"
        android:strokeWidth="1.5" />
    <path
        android:fillColor="#00000000"
        android:pathData="M34,64h40"
        android:strokeColor="#66F3F6F1"
        android:strokeWidth="1.5" />

    <!-- Centre line, broken at the net -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,25L54,44"
        android:strokeColor="#66F3F6F1"
        android:strokeWidth="1.5" />
    <path
        android:fillColor="#00000000"
        android:pathData="M54,64L54,83"
        android:strokeColor="#66F3F6F1"
        android:strokeWidth="1.5" />

    <!-- The net -->
    <path
        android:fillColor="#00000000"
        android:pathData="M30,54h48"
        android:strokeColor="#F3F6F1"
        android:strokeWidth="3.5"
        android:strokeLineCap="round" />

    <!-- The shuttle, cork down, crossing the net -->
    <path
        android:fillColor="#E8A251"
        android:pathData="M54,47m-6,0a6,6 0,1 1,12 0a6,6 0,1 1,-12 0" />
</vector>
