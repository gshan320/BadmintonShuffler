<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The launch theme only exists to paint the window before Compose takes over. It matches
      CourtDeep so a cold start does not flash white in a dark hall.
    -->
    <style name="Theme.CourtShuffler" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/court_deep</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>
